ANTHROPIC_API_KEY=sk-ant-PEGA_TU_API_KEY_AQUI

# Base de datos SQL Server
DB_USER=USUARIO_SQL
DB_PASSWORD=PASSWORD_SQL
DB_SERVER=localhost
DB_NAME=CAC
DB_PORT=1433

# Puerto del servidor Node.js
PORT=3000

# Envío de informes por correo
# MAIL_PROVIDER = office365 (correo @insepet.com sobre Microsoft 365) | gmail
MAIL_PROVIDER=office365
MAIL_USER=reportes@insepet.com
# office365: contraseña normal del buzón (el admin de M365 debe habilitar
#   "SMTP AUTH" para esta cuenta: Exchange admin center > destinatarios >
#   buzones > este buzón > correo autenticado). Si la cuenta tiene MFA
#   obligatorio, usa una contraseña de aplicación en su lugar.
# gmail: contraseña de aplicación de 16 letras, generada en
#   https://myaccount.google.com/apppasswords (requiere verificación en dos pasos).
MAIL_PASS=contraseña-del-buzon-o-de-aplicacion
